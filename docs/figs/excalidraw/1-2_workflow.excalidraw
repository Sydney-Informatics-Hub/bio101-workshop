      "boundElements": [],
      "updated": 1789275558191,
      "link": null,
      "locked": false,
      "text": "Define scientific question\n - Identify knowledge gap\n - Prepare a hypothesis\n\nFind the right molecule\nSelect the omics platform\n\nDesign the cohort \n - Select samples\n - Prepare metadata\n - Reduce bias\n",
      "fontSize": 21.220519141496144,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Define scientific question\n - Identify knowledge gap\n - Prepare a hypothesis\n\nFind the right molecule\nSelect the omics platform\n\nDesign the cohort \n - Select samples\n - Prepare metadata\n - Reduce bias\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "F026o3k_K-A2RzMuZUfh2",
      "type": "text",
      "x": 422.17814375121293,
      "y": 319.5076125606472,
